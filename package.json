{
  "name": "git-cloner",
  "version": "1.0.0",
  "description": "Automatically clone GitHub repositories on a schedule — Material 3 desktop app",
  "main": "src/main/main.js",
  "author": "GitHub Auto Cloner",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.4.5",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.git-cloner.app",
    "productName": "Git Cloner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Git Cloner",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "installerIcon": "assets/icons/app.ico",
      "uninstallerIcon": "assets/icons/app.ico"
    }
  }
}
