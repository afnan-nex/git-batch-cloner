{
  "name": "git-batch-cloner",
  "version": "1.0.1",
  "description": "Automatically clone GitHub repositories on a schedule — Material 3 desktop app",
  "main": "src/main/main.js",
  "author": {
    "name": "AFNAN",
    "email": "gitbatchcloner@app.local"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.4.5",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.gitbatchcloner.app",
    "productName": "Git Batch Cloner",
    "copyright": "Copyright © 2026 AFNAN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "publisherName": "AFNAN",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Git Batch Cloner",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "installerIcon": "assets/icons/app.ico",
      "uninstallerIcon": "assets/icons/app.ico",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "portable": {
      "artifactName": "Git Batch Cloner-Portable-${version}.exe"
    },
    "artifactName": "${productName}-Setup-${version}.exe"
  }
}
